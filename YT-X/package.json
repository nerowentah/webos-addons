{
  "name": "youtube-extended",
  "version": "1.0.0",
  "description": "Extended YouTube app for webOS",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "webpack --mode=production",
    "build:hd": "webpack --mode=production --env resolution=1280x720",
    "package": "ares-package -n dist",
    "package:hd": "npm run build:hd && npm run package",
    "deploy": "node tools/deploy.ts",
    "deploy:hd": "node tools/deploy.ts --resolution 1280x720",
    "launch": "ares-launch youtube.leanback.v4",
    "inspect": "node tools/inspect.ts",
    "drive": "node tools/drive.ts",
    "verify:device": "node tools/verify-device.ts",
    "compare:chrome": "node tools/compare-chrome.ts",
    "compare:tv": "node tools/compare-tv.ts",
    "manifest": "node tools/gen-manifest.ts youtube.leanback.v4.manifest.json",
    "test": "node --import ./tools/register-ts-resolve.ts --test",
    "test:compat": "es-check && node tools/check-syntax-floor.ts",
    "check:text": "node tools/check-ui-text.ts",
    "lint": "eslint --concurrency auto --max-warnings 0",
    "type-check": "tsc -b",
    "prettier-check": "cd .. && prettier --check .",
    "audit": "node tools/audit.ts",
    "cache:clean": "node -e \"require('node:fs').rmSync('node_modules/.cache/webpack',{recursive:true,force:true})\"",
    "lint:all": "npm run audit && npm run lint && npm run type-check && npm run check:text && npm test && npm run prettier-check",
    "verify": "npm run build && npm run test:compat && npm run check:text"
  },
  "repository": "github:nerowentah/webos-addons",
  "license": "GPL-3.0-only",
  "bugs": "https://github.com/nerowentah/webos-addons/issues",
  "homepage": "https://github.com/nerowentah/webos-addons#readme",
  "dependencies": {
    "@babel/runtime-corejs3": "^8.0.7",
    "core-js-pure": "^3.50.0",
    "tiny-sha256": "^1.0.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/plugin-transform-runtime": "^8.0.6",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@webos-tools/cli": "^3.2.6",
    "acorn": "^8.18.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "css-loader": "^7.1.5",
    "cssnano": "9.9.0",
    "es-check": "^9.8.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-regexp": "^3.3.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.31",
    "postcss-load-config": "^6.0.1",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.6.1",
    "prettier": "^3.9.10",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3"
  },
  "allowScripts": {
    "core-js-pure@3.50.0": true,
    "@webos-tools/cli@3.2.6": true,
    "cpu-features@0.0.10": true,
    "ssh2@1.17.0": true
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
