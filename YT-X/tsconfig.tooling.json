{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "checkJs": true,
    // The tools run natively under Node (type stripping), which needs the .ts
    // extension on relative imports and only supports erasable syntax.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,

    "module": "NodeNext",

    "moduleResolution": "NodeNext"
  },
  "include": [
    "./tools",
    "./types",
    "./assets/appinfo.json",
    "./package.json",
    "./webpack.config.js",
    "eslint.config.ts",
    "babel.config.js",
    "postcss.config.ts"
  ]
}
