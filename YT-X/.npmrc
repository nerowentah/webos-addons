# Enforce the Node engine range declared in package.json.
engine-strict=true

# Turn the package.json `allowScripts` allowlist into a hard gate: any
# dependency with install scripts that is not reviewed there fails the install.
strict-allow-scripts=true

# Pin saved dependency versions exactly; the lockfile stays the source of truth.
save-exact=true

# Fail installs when npm audit reports a vulnerability.
audit=true

# Skip funding messages in install output.
fund=false
